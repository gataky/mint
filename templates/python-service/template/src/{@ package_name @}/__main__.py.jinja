"""This service's composition root: the one place that knows how the pieces fit together.

Belongs here: loading configuration, building the logger and the tracer,
constructing the repository, injecting it into the service layer, injecting
that into the transport, starting the listeners and shutting them down.

Does NOT belong here: business rules, request or response types, SQL, or
anything a test would want to call. This module has no unit tests by design —
if you find yourself wanting one, the thing you want to test belongs under
`internal/`.

This module must not import FastAPI, and must not read an environment
variable. `make lint` fails on either: the app is constructed in
`internal/transport/http`, and the environment is read only in
`internal/config`.

It is also why the entry point is `python -m {@ package_name @}` rather than
the `uvicorn` CLI. The CLI configures logging *before* importing the app,
installing non-propagating handlers that no in-app configuration can reclaim,
and the service would ship two log formats.
"""

import argparse
import sys

import uvicorn

from {@ package_name @}.internal.config import ConfigError, load
from {@ package_name @}.internal.transport.http.server import app


def main() -> None:
    """Serve the API and block until the server stops."""
    # Flags point at where configuration lives; no flag sets a configuration
    # VALUE. A flag that set a value would be a third source wearing a
    # disguise, and docs/config.md promises there are two.
    parser = argparse.ArgumentParser(prog="{@ service_name @}")
    parser.add_argument(
        "--print-config",
        action="store_true",
        help="print the effective configuration with secrets masked, and exit",
    )
    parser.add_argument(
        "--config-dir",
        default="config",
        help="directory holding config.yaml and config.local.yaml",
    )
    args = parser.parse_args()

    try:
        cfg = load(args.config_dir)
    except ConfigError as exc:
        # Every invalid field at once, not the first one. Stderr and a
        # non-zero exit: a misconfigured process must not start.
        print(str(exc), file=sys.stderr)  # noqa: T201
        raise SystemExit(1) from None

    if args.print_config:
        print(cfg.render(), end="")  # noqa: T201
        return

    # One plain line, not a log record. Mint chunk 04 owns logging, and a
    # half-configured logger here would be the thing chunk 04 has to undo.
    # flush=True because stdout is block-buffered when it is not a terminal,
    # and a startup line that appears only after the process dies is worse
    # than no startup line.
    print(  # noqa: T201
        f"{cfg.service.name} listening on http://{cfg.server.host}:{cfg.server.port}",
        flush=True,
    )

    # log_config=None keeps uvicorn from calling dictConfig() and stealing the
    # root handler; access_log=False retires its unstructured access line.
    # Mint chunk 04 installs the handler this leaves room for.
    #
    # Chunk 06 replaces uvicorn.run() with an explicit Config/Server pair per
    # listener and its own signal handling. BOTH kwargs must survive that
    # move into uvicorn.Config — losing either silently restores uvicorn's
    # handlers, and the symptom (correct logs in tests, two formats in
    # production) shows up nowhere near the change that caused it.
    #
    # server_header=False because Go's net/http sends no Server header, and
    # parity is a promise about what goes over the wire, not just about which
    # files exist.
    uvicorn.run(
        app,
        host=cfg.server.host,
        port=cfg.server.port,
        log_config=None,
        access_log=False,
        server_header=False,
    )


if __name__ == "__main__":
    main()
