"""Durations, in Go's spelling, because both of Mint's languages must agree.

Durations are the one configuration type whose textual form is a language's
convention rather than a standard. Go's `time.ParseDuration` grammar — `5s`,
`1m30s`, `250ms` — is the one both Mint templates use, so this module
reimplements Go's parser and its canonical formatter rather than reaching for
`timedelta`, whose spelling is very different and whose `str()` prints
`0:00:05`.

That means `make config` prints `5s` in a Python service and `5s` in a Go
service, and `MINT_SERVER__READ_TIMEOUT=1m30s` means the same thing in both.
If the accepted syntax changes here, it changes in `duration.go` in the same
commit.
"""

import re
from datetime import timedelta
from decimal import Decimal
from typing import Any, Self

from pydantic import GetCoreSchemaHandler
from pydantic_core import core_schema

_NANOSECOND = 1
_MICROSECOND = 1_000
_MILLISECOND = 1_000_000
_SECOND = 1_000_000_000
_MINUTE = 60 * _SECOND
_HOUR = 60 * _MINUTE

# The unit names Go accepts, longest-first inside each pair so that "ms" is
# never read as "m" followed by a stray "s".
_UNITS = {
    "ns": _NANOSECOND,
    "us": _MICROSECOND,
    "µs": _MICROSECOND,
    "μs": _MICROSECOND,
    "ms": _MILLISECOND,
    "s": _SECOND,
    "m": _MINUTE,
    "h": _HOUR,
}

_PART = re.compile(r"([0-9]*(?:\.[0-9]*)?)(ns|us|µs|μs|ms|s|m|h)")


class Duration:
    """A span of time that reads and prints the way Go writes one.

    Held as whole nanoseconds so that a value round-trips through
    `make config` unchanged; `timedelta` only resolves to microseconds.
    """

    __slots__ = ("_ns",)

    def __init__(self, nanoseconds: int) -> None:
        """Build a duration from whole nanoseconds."""
        self._ns = nanoseconds

    @property
    def nanoseconds(self) -> int:
        """Return the duration in whole nanoseconds."""
        return self._ns

    @property
    def seconds(self) -> float:
        """Return the duration in seconds, which is what uvicorn takes."""
        return self._ns / _SECOND

    def as_timedelta(self) -> timedelta:
        """Return the duration as a `timedelta`, rounded to microseconds."""
        return timedelta(microseconds=self._ns / 1_000)

    def __str__(self) -> str:
        """Render in Go's canonical form: `5s`, `1m30s`, `250ms`."""
        return _format(self._ns)

    def __repr__(self) -> str:
        """Render for a traceback, unambiguously."""
        return f"Duration({self})"

    def __eq__(self, other: object) -> bool:
        """Compare by nanoseconds."""
        if not isinstance(other, Duration):
            return NotImplemented
        return self._ns == other._ns

    def __hash__(self) -> int:
        """Hash by nanoseconds, so a Duration can live in a frozen model."""
        return hash(self._ns)

    @classmethod
    def __get_pydantic_core_schema__(
        cls,
        source_type: Any,  # noqa: ANN401  # pydantic's hook signature
        handler: GetCoreSchemaHandler,
    ) -> core_schema.CoreSchema:
        """Tell pydantic a Duration is already a Duration.

        The string is converted before this runs, by the `BeforeValidator` in
        `config.py`, so that a bad value produces Mint's message rather than
        pydantic's.
        """
        return core_schema.is_instance_schema(cls)

    @classmethod
    def parse(cls, text: str) -> Self:
        """Parse Go duration syntax, raising `ValueError` on anything else.

        Accepts an optional sign, then one or more number/unit pairs, with
        units `ns`, `us`, `ms`, `s`, `m`, `h`. A bare `0` is zero. A bare
        number with no unit is an error, exactly as in Go — `5` is not five of
        anything.
        """
        rest = text
        negative = False

        if rest[:1] in {"+", "-"}:
            negative = rest[0] == "-"
            rest = rest[1:]

        if rest == "0":
            return cls(0)

        if not rest:
            msg = f"invalid duration {text!r}"
            raise ValueError(msg)

        total = Decimal(0)

        while rest:
            match = _PART.match(rest)
            if match is None or match.group(1) in {"", "."}:
                msg = f"invalid duration {text!r}"
                raise ValueError(msg)

            total += Decimal(match.group(1)) * _UNITS[match.group(2)]
            rest = rest[match.end() :]

        nanoseconds = int(total)

        return cls(-nanoseconds if negative else nanoseconds)


def _format(nanoseconds: int) -> str:
    """Port of Go's `Duration.String`, digit for digit."""
    magnitude = abs(nanoseconds)

    if magnitude < _SECOND:
        if magnitude == 0:
            return "0s"

        if magnitude < _MICROSECOND:
            precision, unit = 0, "ns"
        elif magnitude < _MILLISECOND:
            precision, unit = 3, "µs"
        else:
            precision, unit = 6, "ms"

        fraction, whole = _fraction(magnitude, precision)
        out = f"{whole}{fraction}{unit}"
    else:
        fraction, seconds = _fraction(magnitude, 9)
        out = f"{seconds % 60}{fraction}s"

        minutes = seconds // 60
        if minutes > 0:
            out = f"{minutes % 60}m{out}"

            hours = minutes // 60
            if hours > 0:
                out = f"{hours}h{out}"

    return f"-{out}" if nanoseconds < 0 else out


def _fraction(value: int, precision: int) -> tuple[str, int]:
    """Split off `precision` decimal places, dropping trailing zeros.

    Returns the fractional text (with its leading `.`, or empty) and what is
    left of the value.
    """
    digits = ""
    printing = False

    for _ in range(precision):
        digit = value % 10
        printing = printing or digit != 0

        if printing:
            digits = f"{digit}{digits}"

        value //= 10

    if printing:
        digits = f".{digits}"

    return digits, value
