"""Tests for internal/config.

These tests and `config_test.go` in Mint's Go template assert the same facts
in the same order. When one changes, the other changes in the same commit —
that is what keeps `make config` diff-identical between a Go service and a
Python service.

They live next to the code they test, the way Go's do, so that mint's
`make parity` can diff the two languages' file trees name for name.
"""

from pathlib import Path
from typing import cast

import pytest
from pydantic_settings import PydanticBaseSettingsSource

from {@ package_name @}.internal.config import (
    MASK,
    ConfigError,
    Duration,
    Settings,
    default,
    env_name,
    keys,
    load,
    source_names,
)
from {@ package_name @}.internal.config.config import Section, check_keys, fields
from {@ package_name @}.internal.config.source import OTLP_KEY, MappingSource, key_for


def write_config(tmp_path: Path, files: dict[str, str]) -> Path:
    """Write a config directory and return its path."""
    directory = tmp_path / "config"
    directory.mkdir(exist_ok=True)

    for name, body in files.items():
        (directory / name).write_text(body, encoding="utf-8")

    return directory


def load_err(directory: Path) -> str:
    """Fail the test if configuration DOES load."""
    with pytest.raises(ConfigError) as caught:
        load(directory)

    return str(caught.value)


# TestSourceListIsExactlyTwo is the check ADR 0006 exists for. pydantic-settings
# defaults to FOUR sources; if either language grows or loses one, this fails
# before anything reaches production.
def test_source_list_is_exactly_two() -> None:
    assert source_names() == ["yaml", "env"], "see docs/config.md"


def test_settings_actually_uses_those_two_sources(tmp_path: Path) -> None:
    # source_names() reports what build_sources returns; THIS asserts what
    # pydantic is actually handed. Deleting settings_customise_sources would
    # restore init/env/dotenv/file-secret and leave source_names() lying.
    nothing = cast(PydanticBaseSettingsSource, None)
    customised = Settings.settings_customise_sources(
        Settings,
        init_settings=nothing,
        env_settings=nothing,
        dotenv_settings=nothing,
        file_secret_settings=nothing,
    )

    # pydantic wants highest precedence first; docs/config.md lists lowest first.
    ours = [cast(MappingSource, source) for source in reversed(customised)]

    assert [source.name for source in ours] == ["yaml", "env"]


def test_env_file_is_never_configured() -> None:
    # pydantic-settings ships the key with a None default; what must never
    # happen is someone giving it a value.
    assert Settings.model_config.get("env_file") is None, "the application never reads .env"


def test_dotenv_file_changes_nothing(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    directory = write_config(tmp_path, {"config.yaml": "server:\n  port: 9001\n"})
    (tmp_path / ".env").write_text("MINT_SERVER__PORT=9999\n", encoding="utf-8")
    monkeypatch.chdir(tmp_path)

    assert load(directory).server.port == 9001, ".env is direnv's business, not the app's"


# TestBootsWithNothing is acceptance criterion one: no config files, no
# environment.
def test_boots_with_nothing(tmp_path: Path) -> None:
    cfg = load(tmp_path / "does-not-exist")

    assert cfg.env == "local"
    assert cfg.server.host == "127.0.0.1", "binding every interface is a decision"
    assert cfg.server.port != 0, "the defaults must be complete"


# TestEnvNameMapping is ADR 0002's worked examples, produced by the same rule
# the loader uses rather than written down a second time.
def test_env_name_mapping() -> None:
    cases = {
        "env": "MINT_ENV",
        "service.name": "MINT_SERVICE__NAME",
        "server.port": "MINT_SERVER__PORT",
        "server.admin_port": "MINT_SERVER__ADMIN_PORT",
        "server.read_timeout": "MINT_SERVER__READ_TIMEOUT",
        "server.timeouts.read_header": "MINT_SERVER__TIMEOUTS__READ_HEADER",
        "logging.format": "MINT_LOGGING__FORMAT",
        "logging.level": "MINT_LOGGING__LEVEL",
        "observability.tracing.otlp_endpoint": "MINT_OBSERVABILITY__TRACING__OTLP_ENDPOINT",
        "observability.metrics.namespace": "MINT_OBSERVABILITY__METRICS__NAMESPACE",
        "database.password": "MINT_DATABASE__PASSWORD",
    }

    for key, want in cases.items():
        assert env_name(key) == want
        assert key_for(want) == key, "the mapping must be a bijection"


# TestKeysAreABijection walks the whole config model, which is the assertion
# ADR 0002 § 3 requires rather than a naming guideline.
def test_keys_are_a_bijection() -> None:
    found = fields()

    check_keys(found)

    assert found, "the config model has no keys"
    assert keys() == [f.path for f in found]


class BadServer(Section):
    """A section whose key contains the level separator."""

    read__timeout: str = ""


class BadConfig(Section):
    """A config model that breaks the bijection."""

    server: BadServer = BadServer()


def test_check_keys_rejects_double_underscore() -> None:
    with pytest.raises(ConfigError) as caught:
        check_keys(fields(BadConfig))

    assert "read__timeout" in str(caught.value), "the error must name the offending segment"


# TestEnvBeatsYAML is the precedence rule, in one assertion.
def test_env_beats_yaml(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    directory = write_config(tmp_path, {"config.yaml": "server:\n  port: 9001\n"})
    monkeypatch.setenv("MINT_SERVER__PORT", "9002")

    cfg = load(directory)

    assert cfg.server.port == 9002, "env beats yaml"
    assert cfg.origin("server.port") == "env"


def test_local_yaml_beats_yaml(tmp_path: Path) -> None:
    directory = write_config(
        tmp_path,
        {"config.yaml": "server:\n  port: 9001\n", "config.local.yaml": "server:\n  port: 9003\n"},
    )

    cfg = load(directory)

    assert cfg.server.port == 9003
    assert cfg.origin("server.port") == "local yaml"


# TestEmptyIsAValue — MINT_SERVER__PORT= is "present and empty". It fails
# validation naming the variable; it does NOT fall through to YAML.
def test_empty_is_a_value(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    directory = write_config(tmp_path, {"config.yaml": "server:\n  port: 9001\n"})
    monkeypatch.setenv("MINT_SERVER__PORT", "")

    assert '  - server.port (MINT_SERVER__PORT): "" is not an integer' in load_err(directory)


# TestDuplicateNormalization — two spellings of one variable is a startup error
# naming both, not a coin flip. pydantic would otherwise pick one silently.
def test_duplicate_normalization(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("MINT_SERVER__PORT", "9004")
    monkeypatch.setenv("mint_server__port", "9005")

    message = load_err(tmp_path)

    for want in ("MINT_SERVER__PORT", "mint_server__port", "normalize to one variable"):
        assert want in message


def test_lower_case_env_is_accepted(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("mint_server__port", "9006")

    assert load(tmp_path).server.port == 9006


# TestMultiError is the acceptance criterion: three invalid values produce three
# errors in one message, each naming the config key AND the variable.
def test_multi_error(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("MINT_SERVER__PORT", "not-a-number")
    monkeypatch.setenv("MINT_SERVER__TIMEOUTS__READ_HEADER", "abc")
    monkeypatch.setenv("MINT_ENV", "bogus")

    want = "\n".join(
        [
            "config: 3 errors",
            '  - env (MINT_ENV): "bogus" is not one of local, dev, staging, prod',
            '  - server.port (MINT_SERVER__PORT): "not-a-number" is not an integer',
            "  - server.timeouts.read_header (MINT_SERVER__TIMEOUTS__READ_HEADER): "
            '"abc" is not a duration',
        ]
    )

    assert load_err(tmp_path) == want


# TestBareEnvIsIgnored — there are no aliases. LOG_LEVEL is the single
# most-squatted name in any process environment, and inheriting a CI system's
# value would turn a deploy's log volume into an accident.
def test_bare_env_is_ignored(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("ENV", "bogus")
    monkeypatch.setenv("LOG_LEVEL", "trace")
    monkeypatch.setenv("LOG_FORMAT", "pretty")
    monkeypatch.setenv("PORT", "tcp://10.0.162.149:8080")

    cfg = load(tmp_path)

    assert cfg.env == "local", "bare ENV must be read by nothing"
    assert cfg.logging.level == "info", "bare LOG_LEVEL must be read by nothing"
    assert cfg.server.port == default().server.port, "bare PORT must be read by nothing"


# TestSectionAsJSONIsIgnored — env vars carry scalars only. Setting a whole
# section as a JSON blob is unsupported, and both languages ignore it rather
# than one of them accepting it. pydantic's own env source would have parsed it.
def test_section_as_json_is_ignored(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("MINT_SERVER", '{"port": 7777}')

    assert load(tmp_path).server.port != 7777


def test_section_as_non_json_is_ignored(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    # pydantic's EnvSettingsSource raises SettingsError here while Go shrugs.
    # That asymmetry is closed by not using it.
    monkeypatch.setenv("MINT_SERVER", "not-json-at-all")

    load(tmp_path)


def test_unknown_env_key_is_ignored(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("MINT_SOMETHING__ELSE", "1")

    load(tmp_path)


def test_unknown_yaml_key_is_an_error(tmp_path: Path) -> None:
    directory = write_config(tmp_path, {"config.yaml": "server:\n  prot: 9001\n"})

    assert "server.prot (MINT_SERVER__PROT): unknown config key" in load_err(directory)


# TestOTLPFallbackNamesTheVariable — a value from the ADR 0002 § 8 chain must
# say WHICH variable it came from. "env" alone would not tell you what to change.
def test_otlp_fallback_names_the_variable(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("OTEL_EXPORTER_OTLP_ENDPOINT", "http://collector:4317")

    cfg = load(tmp_path)

    assert cfg.observability.tracing.otlp_endpoint == "http://collector:4317"
    assert cfg.origin(OTLP_KEY) == "env (OTEL_EXPORTER_OTLP_ENDPOINT)"


def test_otlp_mint_variable_wins(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("MINT_OBSERVABILITY__TRACING__OTLP_ENDPOINT", "http://mint:4317")
    monkeypatch.setenv("OTEL_EXPORTER_OTLP_TRACES_ENDPOINT", "http://traces:4317")
    monkeypatch.setenv("OTEL_EXPORTER_OTLP_ENDPOINT", "http://all:4317")

    cfg = load(tmp_path)

    assert cfg.observability.tracing.otlp_endpoint == "http://mint:4317"
    assert cfg.origin(OTLP_KEY) == "env"


# TestIdentityIgnoresOTel — Mint defers to OpenTelemetry on how to reach a
# backend and owns who the service is.
def test_identity_ignores_otel(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("OTEL_SERVICE_NAME", "not-this-service")
    monkeypatch.setenv("OTEL_RESOURCE_ATTRIBUTES", "service.name=not-this-service")

    assert load(tmp_path).service.name != "not-this-service"


# TestSecretIsMaskedByItsType — masking follows from the type, not from the
# field's name and not from a call site remembering.
def test_secret_is_masked_by_its_type(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    password = "hunter2"  # noqa: S105  # the point of the test
    monkeypatch.setenv("MINT_DATABASE__PASSWORD", password)

    cfg = load(tmp_path)

    assert cfg.database.password.reveal() == password, "the secret did not load"
    assert str(cfg.database.password) == MASK
    assert password not in repr(cfg.database.password)

    rendered = cfg.render()

    assert password not in rendered, "make config printed the secret"
    assert MASK in rendered


def test_render_names_every_source_and_key(tmp_path: Path) -> None:
    directory = write_config(tmp_path, {"config.yaml": "logging:\n  level: debug\n"})

    rendered = load(directory).render()

    for key in keys():
        assert key in rendered

    assert "sources, lowest precedence first: yaml, env" in rendered
    assert '"debug"' in rendered


# TestDurationSyntaxIsGos — this module reimplements Go's grammar, so the cases
# both languages must agree on are asserted here too.
def test_duration_syntax_is_gos() -> None:
    cases = {
        "5s": "5s",
        "90s": "1m30s",
        "1.5s": "1.5s",
        "250ms": "250ms",
        "0": "0s",
        "1h2m3s": "1h2m3s",
        "-5s": "-5s",
        "60s": "1m0s",
    }

    for text, want in cases.items():
        assert str(Duration.parse(text)) == want

    with pytest.raises(ValueError, match="invalid duration"):
        Duration.parse("5")


def test_negative_duration_rejected(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("MINT_SERVER__TIMEOUTS__IDLE", "-5s")

    want = '  - server.timeouts.idle (MINT_SERVER__TIMEOUTS__IDLE): "-5s" must not be negative'
    assert want in load_err(tmp_path)


def test_port_range_rejected(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("MINT_SERVER__ADMIN_PORT", "70000")

    want = (
        "  - server.admin_port (MINT_SERVER__ADMIN_PORT): "
        '"70000" is not a port between 1024 and 65535'
    )
    assert want in load_err(tmp_path)


# TestSingularErrorNoun — "1 error", not "1 errors". The Go template says the
# same thing.
def test_singular_error_noun(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("MINT_ENV", "bogus")

    assert load_err(tmp_path).startswith("config: 1 error\n")
