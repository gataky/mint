[project]
name = "[[ service_name ]]"
version = "0.1.0"
description = "[[ service_description ]]"
readme = "README.md"
# Pinned to a single CPython minor series on purpose. uv.lock resolves against
# this, so moving off 3.14 means re-resolving and re-verifying the whole
# dependency set — a decision, not a side effect.
requires-python = "==3.14.*"
dependencies = [
    # Exact pins, never ranges. Two people minting a week apart must get the
    # same toolchain, or the mint mark in README.md stops identifying a build.
    # uv.lock pins the transitive set the same way, and is committed.
    "fastapi==0.141.1",
    "uvicorn==0.52.3",
]

[dependency-groups]
dev = [
    # httpx2, NOT httpx: starlette's TestClient emits a deprecation warning on
    # httpx, and a warning that ships in every service on day one is a warning
    # everyone learns to ignore.
    "httpx2==2.10.0",
    "mypy==2.3.0",
    "pytest==9.1.1",
    "pytest-asyncio==1.4.0",
    "ruff==0.16.3",
]

[build-system]
requires = ["hatchling==1.32.0"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/[[ package_name ]]"]

# --- ruff -------------------------------------------------------------------

[tool.ruff]
line-length = 100
target-version = "py314"
src = ["src"]

[tool.ruff.lint]
# EXPLICIT, never ruff's defaults. Ruff 0.16.0 changed its default rule set
# from 59 rules to 413 and dropped 18 others; inheriting defaults means a ruff
# upgrade silently changes what `make lint` means. Every entry below is a
# choice someone made.
select = [
    "F",   # pyflakes
    "E",   # pycodestyle errors
    "W",   # pycodestyle warnings
    "I",   # import sorting
    "N",   # pep8 naming
    "D",   # docstrings — every module here says what belongs in it
    "UP",  # pyupgrade
    "ANN", # missing annotations; mypy --strict cannot see what is not written
    "S",   # bandit
    "B",   # bugbear
    "A",   # shadowing a builtin
    "C4",  # comprehensions
    "T20", # print() — logging is structured, see docs/logging.md
    "SIM", # simplifications
    "PTH", # pathlib over os.path
    "RUF",
]

[tool.ruff.lint.pydocstyle]
convention = "google"

# --- mypy -------------------------------------------------------------------

[tool.mypy]
python_version = "3.14"
strict = true
files = ["src"]
# Go type-checks as part of compilation; Python does not. mypy in `make lint`
# is what makes the two languages' lint targets mean the same thing.
