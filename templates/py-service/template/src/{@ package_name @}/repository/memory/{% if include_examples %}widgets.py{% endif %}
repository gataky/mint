"""In-memory widget store."""

from __future__ import annotations

import asyncio

from {@ package_name @}.domain import NotFoundError, Widget


class Widgets:
    """A widget store backed by a dict.

    The lock is not about the dict, which is protected by the GIL — it is so
    that a read-modify-write sequence stays atomic across an await, which is
    what a real repository's transaction would give you.
    """

    def __init__(self) -> None:
        self._items: dict[str, Widget] = {}
        self._lock = asyncio.Lock()

    async def list(self) -> list[Widget]:
        """Every widget, oldest first."""
        async with self._lock:
            return sorted(self._items.values(), key=lambda w: (w.created_at, w.id))

    async def get(self, widget_id: str) -> Widget:
        """One widget by ID."""
        async with self._lock:
            widget = self._items.get(widget_id)
        if widget is None:
            raise NotFoundError(f'no widget with id "{widget_id}"')
        return widget

    async def find_by_name(self, name: str) -> Widget | None:
        """The widget with this name, case-insensitively, or None."""
        async with self._lock:
            for widget in self._items.values():
                if widget.name.casefold() == name.casefold():
                    return widget
        return None

    async def create(self, widget: Widget) -> None:
        """Store a widget."""
        async with self._lock:
            self._items[widget.id] = widget
