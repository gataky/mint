"""The order routes.

Adding a resource means adding a module like this one and including its router
in ``create_api``.
"""

from __future__ import annotations

from typing import Annotated, Any

from fastapi import APIRouter, Depends, Path, Request, status

from {@ package_name @}.api.problem import PROBLEM_CONTENT_TYPE
from {@ package_name @}.domain import NewOrder, Order
from {@ package_name @}.service import Orders


def get_orders(request: Request) -> Orders:
    """Hand the handler the service the composition root built."""
    orders: Orders = request.app.state.orders
    return orders


OrdersDep = Annotated[Orders, Depends(get_orders)]

_PROBLEM: dict[str, Any] = {"content": {PROBLEM_CONTENT_TYPE: {}}}

router = APIRouter(prefix="/orders", tags=["orders"])


@router.get(
    "",
    operation_id="orders.list",
    summary="List orders",
    description="Returns every order, oldest first.",
)
async def list_orders(orders: OrdersDep) -> list[Order]:
    return await orders.list()


@router.get(
    "/{id}",
    operation_id="orders.get",
    summary="Fetch an order by ID",
    responses={status.HTTP_404_NOT_FOUND: _PROBLEM},
)
async def get_order(
    orders: OrdersDep,
    order_id: Annotated[
        str, Path(alias="id", min_length=1, max_length=64, description="Order identifier.")
    ],
) -> Order:
    return await orders.get(order_id)


@router.post(
    "",
    operation_id="orders.create",
    summary="Place an order",
    description="Orders a quantity of one widget. The widget must exist.",
    status_code=status.HTTP_201_CREATED,
    responses={status.HTTP_400_BAD_REQUEST: _PROBLEM},
)
async def create_order(orders: OrdersDep, new: NewOrder) -> Order:
    return await orders.create(new)
