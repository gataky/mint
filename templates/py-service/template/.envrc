# One `direnv allow` and this service is ready to run.
#
# asdf reads .tool-versions and puts the pinned Python and uv on PATH.
use asdf

# Local secrets and overrides. This is direnv's business, never the
# application's: config.py reads the environment, and how the environment got
# populated is not its concern. pydantic-settings would happily read .env
# itself, which is exactly why that source is switched off.
dotenv_if_exists .env

# uv keeps the virtualenv in .venv; put its binaries on PATH so `pytest` and
# friends work without the `uv run` prefix.
layout python
PATH_add .venv/bin
