package config

// The ordered source list. This file is the whole of ADR 0006's seam: a third
// source would be one type implementing Source and one insertion at the right
// index in Sources. No caller changes, and precedence is expressed nowhere
// else.
//
// There are exactly two sources on purpose. An unused code path in a template
// is worse than no path — every generated service inherits its maintenance
// cost, in two languages, forever.

import (
	"fmt"
	"os"
	"path/filepath"
	"sort"
	"strings"

	"go.yaml.in/yaml/v3"
)

// Source is one place configuration values come from. Load returns raw
// scalars keyed by config key path ("server.timeouts.read_header"); parsing
// and validation belong to the loader, so every source's bad input produces
// the same message.
//
// A source may return values AND an error: the error carries the values it
// could not accept, so a bad file still reports every one of its problems in
// one pass instead of the first.
type Source interface {
	Name() string
	Load() (map[string]string, error)
}

// originer is an optional refinement of Source for sources that can say more
// precisely where a value came from than their own name — which config/ file
// it was, or which foreign environment variable the ADR 0002 § 8 fallback
// chain resolved. `make config` prints what this returns.
type originer interface {
	Origin(key string) string
}

// Sources is the ordered source list, LOWEST precedence first.
//
// known is the set of config keys this service has, so each source can decide
// what to do with a key that is not one of them: the YAML file is this
// service's own file, so a stray key there is a typo and an error; the
// environment is shared with everything else on the box, so a stray MINT_
// variable there may belong to a sibling service and is ignored.
func Sources(dir string, known map[string]bool) []Source {
	return []Source{
		newYAMLSource(dir, known),
		newEnvSource(known),
	}
}

// SourceNames returns the ordered source list by name, lowest precedence
// first. It is derived from Sources itself rather than written down twice, so
// a source added without being named here is impossible.
//
// docs/config.md documents this list, a test asserts it is exactly
// ["yaml", "env"], and mint's `make parity` diffs it against the Python
// template's. That is what turns a silently reintroduced source into a build
// failure instead of a production surprise.
func SourceNames() []string {
	sources := Sources("", nil)
	out := make([]string, 0, len(sources))

	for _, s := range sources {
		out = append(out, s.Name())
	}

	return out
}

// sourceError carries the problems a source found while still letting it
// return the values it did accept.
type sourceError struct {
	errs []FieldError
}

func (e *sourceError) Error() string {
	return fmt.Sprintf("%d invalid configuration values", len(e.errs))
}

// originOf asks a source where a key came from, falling back to its name.
func originOf(src Source, key string) string {
	if o, ok := src.(originer); ok {
		if origin := o.Origin(key); origin != "" {
			return origin
		}
	}

	return src.Name()
}

// --- YAML ------------------------------------------------------------------

// yamlSource reads config.yaml and then overlays config.local.yaml. They are
// ONE source: the local file is a machine-specific overlay of the committed
// defaults, not a third place precedence has to be explained.
type yamlSource struct {
	dir     string
	known   map[string]bool
	origins map[string]string
}

func newYAMLSource(dir string, known map[string]bool) *yamlSource {
	return &yamlSource{dir: dir, known: known, origins: map[string]string{}}
}

// Name identifies this source in SourceNames and in `make config`.
func (s *yamlSource) Name() string { return "yaml" }

// Origin names which of the two files a key actually came from.
func (s *yamlSource) Origin(key string) string { return s.origins[key] }

// Load reads both files, lowest precedence first. A missing file is not an
// error: a service must boot with no config files at all.
func (s *yamlSource) Load() (map[string]string, error) {
	files := []struct {
		path   string
		origin string
	}{
		{filepath.Join(s.dir, "config.yaml"), "yaml"},
		{filepath.Join(s.dir, "config.local.yaml"), "local yaml"},
	}

	out := map[string]string{}

	var errs []FieldError

	for _, f := range files {
		raw, err := os.ReadFile(f.path)
		if os.IsNotExist(err) {
			continue
		}

		if err != nil {
			return nil, fmt.Errorf("reading %s: %w", f.path, err)
		}

		var doc yaml.Node
		if err := yaml.Unmarshal(raw, &doc); err != nil {
			return nil, fmt.Errorf("parsing %s: %w", f.path, err)
		}

		flat := map[string]string{}
		flatten(&doc, nil, flat, f.path, &errs)

		for _, key := range sortedKeys(flat) {
			if !s.known[key] {
				errs = append(errs, FieldError{
					Key:    key,
					Env:    EnvName(key),
					Detail: "unknown config key, set in " + f.path,
				})

				continue
			}

			out[key] = flat[key]
			s.origins[key] = f.origin
		}
	}

	if len(errs) > 0 {
		return out, &sourceError{errs: errs}
	}

	return out, nil
}

// flatten walks the YAML document into key-path/scalar pairs. It reads the
// node's raw text rather than decoding into `any`, so "5s" stays "5s" and
// every value reaches the same parser the environment's values reach.
func flatten(n *yaml.Node, path []string, out map[string]string, file string, errs *[]FieldError) {
	switch n.Kind {
	case yaml.DocumentNode:
		for _, c := range n.Content {
			flatten(c, path, out, file, errs)
		}

	case yaml.MappingNode:
		for i := 0; i+1 < len(n.Content); i += 2 {
			key, val := n.Content[i], n.Content[i+1]

			next := make([]string, 0, len(path)+1)
			next = append(next, path...)
			next = append(next, key.Value)

			flatten(val, next, out, file, errs)
		}

	case yaml.ScalarNode:
		if n.Tag == "!!null" {
			out[strings.Join(path, ".")] = ""

			return
		}

		out[strings.Join(path, ".")] = n.Value

	case yaml.SequenceNode, yaml.AliasNode:
		key := strings.Join(path, ".")
		*errs = append(*errs, FieldError{
			Key:    key,
			Env:    EnvName(key),
			Detail: "is not a scalar; configuration values are scalars, set in " + file,
		})

	default:
		// A zero Node — an empty file. Nothing to contribute.
	}
}

// --- environment -----------------------------------------------------------

// otlpKey is the one config key with a foreign fallback chain. See
// docs/config.md: Mint defers to OpenTelemetry for how to reach a backend and
// owns who this service is.
const otlpKey = "observability.tracing.otlp_endpoint"

// otlpFallback is the enumerated, closed list of variables Mint does not own
// but does read, highest precedence first. It is read HERE so that the lint
// rule still holds and `make config` can still tell the truth about which
// variable won.
var otlpFallback = []string{
	"OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
	"OTEL_EXPORTER_OTLP_ENDPOINT",
}

// envSource is the only place in this service that reads the environment.
type envSource struct {
	known   map[string]bool
	origins map[string]string
}

func newEnvSource(known map[string]bool) *envSource {
	return &envSource{known: known, origins: map[string]string{}}
}

// Name identifies this source in SourceNames and in `make config`.
func (s *envSource) Name() string { return "env" }

// Origin names the foreign variable a value came from, when it came from one.
func (s *envSource) Origin(key string) string { return s.origins[key] }

// Load reads the environment.
//
// Presence, not emptiness, is what counts: an entry from os.Environ is
// present even when its value is "", so MINT_SERVER__PORT= is "present and
// empty" and fails validation rather than falling through to YAML.
func (s *envSource) Load() (map[string]string, error) {
	spellings := map[string][]string{}
	values := map[string]string{}

	for _, entry := range os.Environ() {
		name, value, ok := strings.Cut(entry, "=")
		if !ok {
			continue
		}

		canonical := strings.ToUpper(name)
		if !strings.HasPrefix(canonical, EnvPrefix) {
			continue
		}

		if !contains(spellings[canonical], name) {
			spellings[canonical] = append(spellings[canonical], name)
		}

		values[canonical] = value
	}

	out := map[string]string{}

	var errs []FieldError

	for _, canonical := range sortedNames(spellings) {
		key := keyFor(canonical)

		// Matching is case-insensitive, so two spellings are two ways to set
		// one value and the loader cannot know which was meant. Naming both
		// is the difference between a startup error and a coin flip.
		if names := spellings[canonical]; len(names) > 1 {
			sort.Strings(names)

			errs = append(errs, FieldError{
				Key:    key,
				Env:    canonical,
				Detail: "set by " + strings.Join(names, " and ") + ", which normalize to one variable",
			})

			continue
		}

		if !s.known[key] {
			continue // may belong to another Mint service sharing this environment
		}

		out[key] = values[canonical]
	}

	if _, set := out[otlpKey]; !set && s.known[otlpKey] {
		for _, name := range otlpFallback {
			if value, ok := os.LookupEnv(name); ok {
				out[otlpKey] = value
				s.origins[otlpKey] = "env (" + name + ")"

				break
			}
		}
	}

	if len(errs) > 0 {
		return out, &sourceError{errs: errs}
	}

	return out, nil
}

// keyFor decodes an environment variable name back into its config key. The
// mapping is a bijection, which is what makes this function total.
func keyFor(canonical string) string {
	rest := strings.TrimPrefix(canonical, EnvPrefix)

	return strings.ToLower(strings.ReplaceAll(rest, envDelim, "."))
}

func contains(haystack []string, needle string) bool {
	for _, h := range haystack {
		if h == needle {
			return true
		}
	}

	return false
}

func sortedNames(m map[string][]string) []string {
	out := make([]string, 0, len(m))
	for k := range m {
		out = append(out, k)
	}

	sort.Strings(out)

	return out
}
