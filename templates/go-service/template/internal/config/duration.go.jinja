package config

// Durations are the one config type whose textual form is a language's
// convention rather than a standard. Go's time.ParseDuration grammar ("5s",
// "1m30s", "250ms") is the one both Mint templates use, which means the
// Python template reimplements this file's two functions rather than reaching
// for timedelta's very different spelling. If you change the accepted syntax
// here, change it there in the same commit.

import "time"

// Duration is a time.Duration that reads from YAML and from the environment
// as Go duration syntax and prints the same way in `make config`.
//
// It is a distinct type rather than a bare time.Duration so the reflective
// walk can tell a duration from the int it is underneath, and so that "abc"
// produces "is not a duration" rather than "is not an integer".
type Duration time.Duration

// String renders the duration in Go's canonical form: 5s, 1m30s, 250ms.
func (d Duration) String() string { return time.Duration(d).String() }

// Duration returns the standard library value, which is what net/http's
// server fields and context deadlines take.
func (d Duration) Duration() time.Duration { return time.Duration(d) }
