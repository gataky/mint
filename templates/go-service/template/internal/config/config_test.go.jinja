package config

// These tests and config_test.py in Mint's Python template assert the same
// facts in the same order. When one changes, the other changes in the same
// commit — that is what keeps `make config` diff-identical between a Go
// service and a Python service.

import (
	"os"
	"path/filepath"
	"reflect"
	"strings"
	"testing"
)

// reflectOf gives setLeaf a settable handle on a value, the way the loader's
// reflective walk does.
func reflectOf(p *Duration) reflect.Value { return reflect.ValueOf(p).Elem() }

// writeConfig writes a config directory and returns its path.
func writeConfig(t *testing.T, files map[string]string) string {
	t.Helper()

	dir := t.TempDir()

	for name, body := range files {
		if err := os.WriteFile(filepath.Join(dir, name), []byte(body), 0o600); err != nil {
			t.Fatalf("writing %s: %v", name, err)
		}
	}

	return dir
}

// mustLoad fails the test if configuration does not load.
func mustLoad(t *testing.T, dir string) *Config {
	t.Helper()

	cfg, err := Load(dir)
	if err != nil {
		t.Fatalf("Load: %v", err)
	}

	return cfg
}

// loadErr fails the test if configuration DOES load.
func loadErr(t *testing.T, dir string) string {
	t.Helper()

	cfg, err := Load(dir)
	if err == nil {
		t.Fatalf("Load succeeded, want an error; got %#v", cfg.Env)
	}

	return err.Error()
}

// TestSourceListIsExactlyTwo is the check ADR 0006 exists for. Python's
// pydantic-settings defaults to FOUR sources; if either language grows or
// loses one, this fails before anything reaches production.
func TestSourceListIsExactlyTwo(t *testing.T) {
	got := strings.Join(SourceNames(), ",")
	if want := "yaml,env"; got != want {
		t.Fatalf("SourceNames() = %q, want %q — see docs/config.md", got, want)
	}
}

// TestBootsWithNothing is acceptance criterion one: no config files, no
// environment.
func TestBootsWithNothing(t *testing.T) {
	cfg := mustLoad(t, filepath.Join(t.TempDir(), "does-not-exist"))

	if cfg.Env != "local" {
		t.Errorf("env = %q, want local", cfg.Env)
	}

	if cfg.Server.Host != "127.0.0.1" {
		t.Errorf("server.host = %q, want 127.0.0.1 — binding every interface is a decision", cfg.Server.Host)
	}

	if cfg.Server.Port == 0 {
		t.Error("server.port is zero; the defaults must be complete")
	}
}

// TestEnvNameMapping is ADR 0002's worked examples, produced by the same rule
// the loader uses rather than written down a second time.
func TestEnvNameMapping(t *testing.T) {
	cases := map[string]string{
		"env":                                 "MINT_ENV",
		"service.name":                        "MINT_SERVICE__NAME",
		"server.port":                         "MINT_SERVER__PORT",
		"server.admin_port":                   "MINT_SERVER__ADMIN_PORT",
		"server.read_timeout":                 "MINT_SERVER__READ_TIMEOUT",
		"server.timeouts.read_header":         "MINT_SERVER__TIMEOUTS__READ_HEADER",
		"logging.format":                      "MINT_LOGGING__FORMAT",
		"logging.level":                       "MINT_LOGGING__LEVEL",
		"observability.tracing.otlp_endpoint": "MINT_OBSERVABILITY__TRACING__OTLP_ENDPOINT",
		"observability.metrics.namespace":     "MINT_OBSERVABILITY__METRICS__NAMESPACE",
		"database.password":                   "MINT_DATABASE__PASSWORD",
	}

	for key, want := range cases {
		if got := EnvName(key); got != want {
			t.Errorf("EnvName(%q) = %q, want %q", key, got, want)
		}

		if back := keyFor(want); back != key {
			t.Errorf("keyFor(%q) = %q, want %q — the mapping must be a bijection", want, back, key)
		}
	}
}

// TestKeysAreABijection walks the whole config type, which is the assertion
// ADR 0002 § 3 requires rather than a naming guideline.
func TestKeysAreABijection(t *testing.T) {
	cfg := Default()

	fields := fieldsOf(&cfg)
	if err := checkKeys(fields); err != nil {
		t.Fatal(err)
	}

	if len(fields) == 0 {
		t.Fatal("the config type has no keys")
	}
}

// badSegment has a key containing the level separator, which would make one
// environment variable name decode to two different config keys.
type badSegment struct {
	Server badSegmentServer `yaml:"server"`
}

type badSegmentServer struct {
	ReadTimeout string `yaml:"read__timeout"`
}

func TestCheckKeysRejectsDoubleUnderscore(t *testing.T) {
	var bad badSegment

	err := checkKeys(fieldsOf(&bad))
	if err == nil {
		t.Fatal("checkKeys accepted a key containing the level separator")
	}

	if !strings.Contains(err.Error(), "read__timeout") {
		t.Errorf("error must name the offending segment; got: %v", err)
	}
}

// TestEnvBeatsYAML is the precedence rule, in one assertion.
func TestEnvBeatsYAML(t *testing.T) {
	dir := writeConfig(t, map[string]string{
		"config.yaml": "server:\n  port: 9001\n",
	})

	t.Setenv("MINT_SERVER__PORT", "9002")

	cfg := mustLoad(t, dir)
	if cfg.Server.Port != 9002 {
		t.Fatalf("server.port = %d, want 9002 (env beats yaml)", cfg.Server.Port)
	}

	if got := cfg.Origin("server.port"); got != "env" {
		t.Errorf("origin = %q, want env", got)
	}
}

// TestLocalYAMLBeatsYAML — the local file is an overlay of the committed
// defaults, and `make config` says which one won.
func TestLocalYAMLBeatsYAML(t *testing.T) {
	dir := writeConfig(t, map[string]string{
		"config.yaml":       "server:\n  port: 9001\n",
		"config.local.yaml": "server:\n  port: 9003\n",
	})

	cfg := mustLoad(t, dir)
	if cfg.Server.Port != 9003 {
		t.Fatalf("server.port = %d, want 9003", cfg.Server.Port)
	}

	if got := cfg.Origin("server.port"); got != "local yaml" {
		t.Errorf("origin = %q, want %q", got, "local yaml")
	}
}

// TestEmptyIsAValue — MINT_SERVER__PORT= is "present and empty". It fails
// validation naming the variable; it does NOT fall through to YAML.
func TestEmptyIsAValue(t *testing.T) {
	dir := writeConfig(t, map[string]string{
		"config.yaml": "server:\n  port: 9001\n",
	})

	t.Setenv("MINT_SERVER__PORT", "")

	got := loadErr(t, dir)

	want := `  - server.port (MINT_SERVER__PORT): "" is not an integer`
	if !strings.Contains(got, want) {
		t.Fatalf("error is\n%s\nwant a line %q", got, want)
	}
}

// TestDuplicateNormalization — two spellings of one variable is a startup
// error naming both, not a coin flip. pydantic would otherwise pick one
// silently.
func TestDuplicateNormalization(t *testing.T) {
	t.Setenv("MINT_SERVER__PORT", "9004")
	t.Setenv("mint_server__port", "9005")

	got := loadErr(t, t.TempDir())

	for _, want := range []string{"MINT_SERVER__PORT", "mint_server__port", "normalize to one variable"} {
		if !strings.Contains(got, want) {
			t.Errorf("error is\n%s\nwant it to mention %q", got, want)
		}
	}
}

// TestLowerCaseEnvIsAccepted — matching is case-insensitive in both
// languages, with UPPER_SNAKE documented as canonical.
func TestLowerCaseEnvIsAccepted(t *testing.T) {
	t.Setenv("mint_server__port", "9006")

	cfg := mustLoad(t, t.TempDir())
	if cfg.Server.Port != 9006 {
		t.Fatalf("server.port = %d, want 9006", cfg.Server.Port)
	}
}

// TestMultiError is the acceptance criterion: three invalid values produce
// three errors in one message, each naming the config key AND the variable.
func TestMultiError(t *testing.T) {
	t.Setenv("MINT_SERVER__PORT", "not-a-number")
	t.Setenv("MINT_SERVER__TIMEOUTS__READ_HEADER", "abc")
	t.Setenv("MINT_ENV", "bogus")

	got := loadErr(t, t.TempDir())

	want := strings.Join([]string{
		"config: 3 errors",
		`  - env (MINT_ENV): "bogus" is not one of local, dev, staging, prod`,
		`  - server.port (MINT_SERVER__PORT): "not-a-number" is not an integer`,
		`  - server.timeouts.read_header (MINT_SERVER__TIMEOUTS__READ_HEADER): "abc" is not a duration`,
	}, "\n")

	if got != want {
		t.Fatalf("multi-error mismatch\n got:\n%s\nwant:\n%s", got, want)
	}
}

// TestBareEnvIsIgnored — there are no aliases. LOG_LEVEL is the single
// most-squatted name in any process environment, and inheriting a CI system's
// value would turn a deploy's log volume into an accident.
func TestBareEnvIsIgnored(t *testing.T) {
	t.Setenv("ENV", "bogus")
	t.Setenv("LOG_LEVEL", "trace")
	t.Setenv("LOG_FORMAT", "pretty")
	t.Setenv("PORT", "tcp://10.0.162.149:8080")

	cfg := mustLoad(t, t.TempDir())

	if cfg.Env != "local" {
		t.Errorf("env = %q; bare ENV must be read by nothing", cfg.Env)
	}

	if cfg.Logging.Level != "info" {
		t.Errorf("logging.level = %q; bare LOG_LEVEL must be read by nothing", cfg.Logging.Level)
	}

	if cfg.Server.Port != Default().Server.Port {
		t.Errorf("server.port = %d; bare PORT must be read by nothing", cfg.Server.Port)
	}
}

// TestSectionAsJSONIsIgnored — env vars carry scalars only. Setting a whole
// section as a JSON blob is unsupported, and both languages ignore it rather
// than one of them accepting it.
func TestSectionAsJSONIsIgnored(t *testing.T) {
	t.Setenv("MINT_SERVER", `{"port": 7777}`)

	cfg := mustLoad(t, t.TempDir())
	if cfg.Server.Port == 7777 {
		t.Fatal("a whole section was set from JSON; env vars carry scalars only")
	}
}

// TestUnknownEnvKeyIsIgnored — the environment is shared, so a MINT_ variable
// that is not one of this service's keys may belong to a sibling service.
func TestUnknownEnvKeyIsIgnored(t *testing.T) {
	t.Setenv("MINT_SOMETHING__ELSE", "1")

	mustLoad(t, t.TempDir())
}

// TestUnknownYAMLKeyIsAnError — this file belongs to this service, so a stray
// key in it is a typo, not someone else's variable.
func TestUnknownYAMLKeyIsAnError(t *testing.T) {
	dir := writeConfig(t, map[string]string{
		"config.yaml": "server:\n  prot: 9001\n",
	})

	got := loadErr(t, dir)
	if !strings.Contains(got, "server.prot (MINT_SERVER__PROT): unknown config key") {
		t.Fatalf("error is\n%s\nwant it to name the unknown key", got)
	}
}

// TestOTLPFallbackNamesTheVariable — a value from the ADR 0002 § 8 chain must
// say WHICH variable it came from. "env" alone would not tell you what to
// change.
func TestOTLPFallbackNamesTheVariable(t *testing.T) {
	t.Setenv("OTEL_EXPORTER_OTLP_ENDPOINT", "http://collector:4317")

	cfg := mustLoad(t, t.TempDir())

	if cfg.Observability.Tracing.OTLPEndpoint != "http://collector:4317" {
		t.Fatalf("otlp_endpoint = %q", cfg.Observability.Tracing.OTLPEndpoint)
	}

	if got, want := cfg.Origin(otlpKey), "env (OTEL_EXPORTER_OTLP_ENDPOINT)"; got != want {
		t.Errorf("origin = %q, want %q", got, want)
	}
}

// TestOTLPMintVariableWins — Mint's own name beats the foreign ones.
func TestOTLPMintVariableWins(t *testing.T) {
	t.Setenv("MINT_OBSERVABILITY__TRACING__OTLP_ENDPOINT", "http://mint:4317")
	t.Setenv("OTEL_EXPORTER_OTLP_TRACES_ENDPOINT", "http://traces:4317")
	t.Setenv("OTEL_EXPORTER_OTLP_ENDPOINT", "http://all:4317")

	cfg := mustLoad(t, t.TempDir())

	if got := cfg.Observability.Tracing.OTLPEndpoint; got != "http://mint:4317" {
		t.Fatalf("otlp_endpoint = %q, want the MINT_ value", got)
	}

	if got := cfg.Origin(otlpKey); got != "env" {
		t.Errorf("origin = %q, want env", got)
	}
}

// TestIdentityIgnoresOTel — Mint defers to OpenTelemetry on how to reach a
// backend and owns who the service is.
func TestIdentityIgnoresOTel(t *testing.T) {
	t.Setenv("OTEL_SERVICE_NAME", "not-this-service")
	t.Setenv("OTEL_RESOURCE_ATTRIBUTES", "service.name=not-this-service")

	cfg := mustLoad(t, t.TempDir())
	if cfg.Service.Name == "not-this-service" {
		t.Fatal("OTEL_SERVICE_NAME set this service's identity; it must be ignored")
	}
}

// TestSecretIsMaskedByItsType — masking follows from the type, not from the
// field's name and not from a call site remembering.
func TestSecretIsMaskedByItsType(t *testing.T) {
	const password = "hunter2"

	t.Setenv("MINT_DATABASE__PASSWORD", password)

	cfg := mustLoad(t, t.TempDir())

	if cfg.Database.Password.Reveal() != password {
		t.Fatalf("the secret did not load")
	}

	if got := cfg.Database.Password.String(); got != maskText {
		t.Errorf("String() = %q, want the mask", got)
	}

	rendered := cfg.Render()
	if strings.Contains(rendered, password) {
		t.Fatalf("make config printed the secret:\n%s", rendered)
	}

	if !strings.Contains(rendered, maskText) {
		t.Errorf("make config did not print the mask:\n%s", rendered)
	}
}

// TestRenderNamesEverySourceAndKey — `make config` is the answer to "why is
// this value X", so every key has to be in it.
func TestRenderNamesEverySourceAndKey(t *testing.T) {
	dir := writeConfig(t, map[string]string{
		"config.yaml": "logging:\n  level: debug\n",
	})

	rendered := mustLoad(t, dir).Render()

	for _, key := range Keys() {
		if !strings.Contains(rendered, key) {
			t.Errorf("make config output is missing %q", key)
		}
	}

	if !strings.Contains(rendered, "sources, lowest precedence first: yaml, env") {
		t.Error("make config must name its sources, in order")
	}

	if !strings.Contains(rendered, `logging.level`) || !strings.Contains(rendered, `"debug"`) {
		t.Error("make config must show the resolved value")
	}
}

// TestDurationSyntaxIsGos — the Python template reimplements this grammar, so
// the cases both must agree on are asserted here too.
func TestDurationSyntaxIsGos(t *testing.T) {
	cases := map[string]string{
		"5s":     "5s",
		"90s":    "1m30s",
		"1.5s":   "1.5s",
		"250ms":  "250ms",
		"0":      "0s",
		"1h2m3s": "1h2m3s",
		"-5s":    "-5s",
	}

	for in, want := range cases {
		var d Duration

		v := reflectOf(&d)
		if err := setLeaf(v, in); err != nil {
			t.Errorf("setLeaf(%q): %v", in, err)

			continue
		}

		if got := d.String(); got != want {
			t.Errorf("%q renders as %q, want %q", in, got, want)
		}
	}

	var d Duration
	if err := setLeaf(reflectOf(&d), "5"); err == nil {
		t.Error(`"5" parsed as a duration; a bare number has no unit`)
	}
}

// TestNegativeDurationRejected keeps the two languages' rule tables in step.
func TestNegativeDurationRejected(t *testing.T) {
	t.Setenv("MINT_SERVER__TIMEOUTS__IDLE", "-5s")

	got := loadErr(t, t.TempDir())

	want := `  - server.timeouts.idle (MINT_SERVER__TIMEOUTS__IDLE): "-5s" must not be negative`
	if !strings.Contains(got, want) {
		t.Fatalf("error is\n%s\nwant a line %q", got, want)
	}
}

// TestPortRangeRejected — the same rule, in both languages.
func TestPortRangeRejected(t *testing.T) {
	t.Setenv("MINT_SERVER__ADMIN_PORT", "70000")

	got := loadErr(t, t.TempDir())

	want := `  - server.admin_port (MINT_SERVER__ADMIN_PORT): "70000" is not a port between 1024 and 65535`
	if !strings.Contains(got, want) {
		t.Fatalf("error is\n%s\nwant a line %q", got, want)
	}
}

// TestSingularErrorNoun — "1 error", not "1 errors". The Python template says
// the same thing.
func TestSingularErrorNoun(t *testing.T) {
	t.Setenv("MINT_ENV", "bogus")

	got := loadErr(t, t.TempDir())
	if !strings.HasPrefix(got, "config: 1 error\n") {
		t.Fatalf("error starts with %q", strings.SplitN(got, "\n", 2)[0])
	}
}
