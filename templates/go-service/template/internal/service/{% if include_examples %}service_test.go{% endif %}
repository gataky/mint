package service_test

import (
	"testing"
	"time"

	"{@ module_path @}/internal/repository/memory"
	"{@ module_path @}/internal/service"
)

// The service tests use the real in-memory repository rather than a bespoke
// mock. There is only one implementation, so the thing exercised here is the
// thing that runs — and a mock of an interface this small would mostly test
// that the mock was written correctly.
//
// They are an external test package (service_test) so they can only reach what
// the composition root can reach.

// fixedClock returns a clock that advances one second per call, so ordering
// assertions can name exact positions without sleeping.
func fixedClock() service.Clock {
	base := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
	var n int
	return func() time.Time {
		n++
		return base.Add(time.Duration(n) * time.Second)
	}
}

// countingIDs returns predictable identifiers.
func countingIDs(prefix string) service.IDGenerator {
	var n int
	return func() string {
		n++
		return prefix + "-" + string(rune('0'+n))
	}
}

// newWidgets builds a widget service over an empty store.
func newWidgets(t *testing.T) *service.Widgets {
	t.Helper()
	return service.NewWidgets(memory.NewWidgets(), countingIDs("widget"), fixedClock())
}

// newOrders builds an order service over an empty store, sharing the widget
// service it must consult.
func newOrders(t *testing.T, widgets *service.Widgets) *service.Orders {
	t.Helper()
	return service.NewOrders(memory.NewOrders(), widgets, countingIDs("order"), fixedClock())
}
