package http

import (
	"net/http"
	"testing"

	"{@ module_path @}/internal/logging"
)

// This service has no resources yet, so these tests cover what the transport
// does regardless of them: the error contract, the access log, and the
// generated OpenAPI document. Delete or extend them once the first resource
// lands — the point is that `make test` is meaningful from the first commit.

func TestUnroutedRequestIsProblemJSON(t *testing.T) {
	handler, _ := newTestAPI(t)

	rec := do(t, handler, http.MethodGet, "/nope", "")
	if rec.Code != http.StatusNotFound {
		t.Fatalf("GET /nope = %d, want %d: %s", rec.Code, http.StatusNotFound, rec.Body)
	}
	if got := rec.Header().Get("Content-Type"); got != ProblemContentType {
		t.Errorf("Content-Type = %q, want %q", got, ProblemContentType)
	}

	body := decode[map[string]any](t, rec)
	for key, want := range map[string]any{
		"type":     DefaultProblemType,
		"title":    "Not Found",
		"status":   float64(http.StatusNotFound),
		"instance": "/nope",
	} {
		if body[key] != want {
			t.Errorf("body[%q] = %v, want %v", key, body[key], want)
		}
	}
}

func TestAccessLogCarriesTheReservedFields(t *testing.T) {
	handler, logs := newTestAPI(t)
	do(t, handler, http.MethodGet, "/nope", "")

	line := lastLogLine(t, logs)
	for _, key := range []string{
		logging.KeyTime, logging.KeyLevel, logging.KeyMessage,
		logging.KeyService, logging.KeyServiceVersion, logging.KeyEnv,
		logging.KeyRequestID,
		"method", "route", "path", "status", "duration_ms",
	} {
		if _, ok := line[key]; !ok {
			t.Errorf("access log line has no %q field: %v", key, line)
		}
	}
}

func TestOpenAPIDocumentIsServed(t *testing.T) {
	handler, _ := newTestAPI(t)

	rec := do(t, handler, http.MethodGet, "/openapi.json", "")
	if rec.Code != http.StatusOK {
		t.Fatalf("GET /openapi.json = %d, want %d", rec.Code, http.StatusOK)
	}

	doc := decode[map[string]any](t, rec)
	info, ok := doc["info"].(map[string]any)
	if !ok {
		t.Fatalf("document has no info object: %s", rec.Body)
	}
	if got := info["title"]; got != "{@ service_name @}" {
		t.Errorf("info.title = %v, want %q", got, "{@ service_name @}")
	}
}
