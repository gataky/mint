package http

import (
	"context"
	"net/http"

	"github.com/danielgtaylor/huma/v2"

	"{@ module_path @}/internal/domain"
	"{@ module_path @}/internal/service"
)

type listOrdersOutput struct {
	Body []domain.Order
}

type getOrderInput struct {
	ID string `path:"id" minLength:"1" maxLength:"64" doc:"Order identifier."`
}

type orderOutput struct {
	Body domain.Order
}

type createOrderInput struct {
	Body domain.NewOrder
}

// registerOrders wires the order operations. Adding a resource means adding a
// file like this one and a call to it in NewAPI.
func registerOrders(api huma.API, orders *service.Orders) {
	huma.Register(api, huma.Operation{
		OperationID: "orders.list",
		Method:      http.MethodGet,
		Path:        "/orders",
		Summary:     "List orders",
		Description: "Returns every order, oldest first.",
		Tags:        []string{"orders"},
	}, func(ctx context.Context, _ *struct{}) (*listOrdersOutput, error) {
		found, err := orders.List(ctx)
		if err != nil {
			return nil, problem(ctx, err)
		}
		return &listOrdersOutput{Body: found}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "orders.get",
		Method:      http.MethodGet,
		Path:        "/orders/{id}",
		Summary:     "Fetch an order by ID",
		Tags:        []string{"orders"},
		Errors:      []int{http.StatusNotFound},
	}, func(ctx context.Context, in *getOrderInput) (*orderOutput, error) {
		found, err := orders.Get(ctx, in.ID)
		if err != nil {
			return nil, problem(ctx, err)
		}
		return &orderOutput{Body: found}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID:   "orders.create",
		Method:        http.MethodPost,
		Path:          "/orders",
		Summary:       "Place an order",
		Description:   "Orders a quantity of one widget. The widget must exist.",
		Tags:          []string{"orders"},
		DefaultStatus: http.StatusCreated,
		Errors:        []int{http.StatusBadRequest},
	}, func(ctx context.Context, in *createOrderInput) (*orderOutput, error) {
		created, err := orders.Create(ctx, in.Body)
		if err != nil {
			return nil, problem(ctx, err)
		}
		return &orderOutput{Body: created}, nil
	})
}
