// Command {@ service_name @} is this service's composition root: the one
// place that knows how the pieces fit together.
//
// Belongs here: loading configuration, building the logger and the tracer,
// constructing the repository, injecting it into the service layer,
// injecting that into the transport, starting the listeners and shutting
// them down.
//
// Does NOT belong here: business rules, HTTP types, SQL, or anything a test
// would want to call. This file has no unit tests by design — if you find
// yourself wanting one, the thing you want to test belongs in internal/.
//
// This file must not import net/http, and must not read an environment
// variable. `make lint` fails on either: servers are constructed in
// internal/transport/http, and the environment is read only in
// internal/config.
package main

import (
	"flag"
	"fmt"
	"net"
	"os"
	"strconv"

	"{@ module_path @}/internal/config"
	transporthttp "{@ module_path @}/internal/transport/http"
)

func main() {
	// Flags point at where configuration lives; no flag sets a configuration
	// VALUE. A flag that set a value would be a third source wearing a
	// disguise, and docs/config.md promises there are two.
	printConfig := flag.Bool("print-config", false,
		"print the effective configuration with secrets masked, and exit")
	configDir := flag.String("config-dir", "config",
		"directory holding config.yaml and config.local.yaml")

	flag.Parse()

	cfg, err := config.Load(*configDir)
	if err != nil {
		// Every invalid field at once, not the first one. Stderr and a
		// non-zero exit: a misconfigured process must not start.
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	if *printConfig {
		fmt.Print(cfg.Render())

		return
	}

	addr := net.JoinHostPort(cfg.Server.Host, strconv.Itoa(cfg.Server.Port))

	// One plain line, not a log record. Mint chunk 04 owns logging, and a
	// half-configured logger here would be the thing chunk 04 has to undo.
	fmt.Printf("%s listening on http://%s\n", cfg.Service.Name, addr)

	if err := transporthttp.ListenAndServe(addr); err != nil {
		fmt.Fprintf(os.Stderr, "%s: %v\n", cfg.Service.Name, err)
		os.Exit(1)
	}
}
