# direnv — run `direnv allow` once and every shell in this directory is set up.
#
# The toolchain itself needs nothing here: asdf's shims read .tool-versions,
# which pins the exact Go this service was minted against.

# Uncommitted local overrides. These arrive as ordinary environment variables
# before any process starts, which is why this is the supported way to keep
# machine-specific values — see docs/config.md. .env is gitignored; do not
# commit one, and do not put a secret in it that you would mind on disk.
dotenv_if_exists .env

# `make build` writes the binary here.
PATH_add bin
