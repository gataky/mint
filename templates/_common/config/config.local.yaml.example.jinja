# Copy me to config.local.yaml, which is gitignored:
#
#     cp config/config.local.yaml.example config/config.local.yaml
#
# config.local.yaml overlays config.yaml on YOUR machine and is never
# committed. It does not have to be complete — every key it omits keeps the
# value config.yaml gives it.
#
# It loses to environment variables, and that includes anything direnv loaded
# from a .env file. If a value here seems to be ignored, run `make config`:
# the source column names what actually won.
#
# NO SECRETS. This file is gitignored, but it is still a plaintext file in a
# working tree that gets copied around. Secrets are environment variables.

# env: local

# server:
#   # Free up 8080 for something else without touching a committed file.
#   port: 18080
#   admin_port: 19080

# logging:
#   # Force JSON locally to see exactly what production will emit.
#   format: json
#   level: debug

# observability:
#   tracing:
#     # A collector you are running locally. Empty means no exporter at all.
#     otlp_endpoint: "http://127.0.0.1:4318"
