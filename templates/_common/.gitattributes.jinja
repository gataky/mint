# Minted from Mint's templates/_common/.

* text=auto eol=lf

# openapi.json and llms.txt are generated by `make agents-docs` and committed,
# so drift shows up as a PR diff. `-merge` turns off git's text merge for
# them: a branch merge that touches both sides leaves the *ours* version in
# the worktree, whole and parseable, instead of a JSON document with conflict
# markers in it.
#
# Resolving a conflict on either file is one line: resolve the conflict in the
# operation registry, then run `make agents-docs`. Never hand-edit them.
openapi.json -merge
llms.txt -merge

# Lockfiles: reviewable, but not worth reviewing line by line.
uv.lock linguist-generated=true
go.sum linguist-generated=true
