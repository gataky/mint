# One `direnv allow` and this service is ready to run.
#
# asdf reads .tool-versions and puts the pinned Go on PATH.
use asdf

# Local secrets and overrides. This is direnv's business, never the
# application's: internal/config reads the environment, and how the environment
# got populated is not its concern.
dotenv_if_exists .env

# Local binaries built by `make build`.
PATH_add bin
